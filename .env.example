# Leave empty in production on Vercel (API is same origin at /api).
# Local dev: point at Express server
VITE_API_URL=http://localhost:4000

# iStreams ERP public SOAP endpoint used to authenticate users (see AuthContext / LoginPage).
# Already set for you in .env.development (proxied via vite.config.ts to dodge CORS)
# and .env.production (direct URL) — override here only if you need something different.
VITE_SOAP_ENDPOINT=https://apps.istreams-erp.com:4439/iStreamsSmartPublic.asmx
